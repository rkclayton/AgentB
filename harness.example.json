{
  "config_version": 2,
  "listen": "127.0.0.1:8790",
  "workspace": "./workspace",
  "log_dir": "logs",
  "servers": [
    {
      "id": "local",
      "label": "Local",
      "base_url": "http://127.0.0.1:8080",
      "model": "",
      "api_key": "",
      "request_timeout_s": 900,
      "probe_mode": "full",
      "sampling": {
        "thinking": { "temperature": 0.6, "top_p": 0.95, "top_k": 20, "min_p": 0.0, "presence_penalty": 0.0, "repeat_penalty": 1.0 },
        "nonthinking": { "temperature": 0.7, "top_p": 0.8, "top_k": 20, "min_p": 0.0, "presence_penalty": 1.5, "repeat_penalty": 1.0 }
      },
      "reasoning": { "control": "auto", "enabled": true, "effort": "medium", "valid_efforts": [], "preserve": false },
      "context": { "n_ctx_override": 0, "reserve_output": 10240 },
      "system_prompt_override": "",
      "capabilities": {
        "server": "",
        "props": false,
        "n_ctx": 0,
        "tokenize": false,
        "apply_template": false,
        "apply_template_tools": false,
        "streaming": false,
        "tool_calls": false,
        "grammar_constrained": false,
        "cached_tokens": false,
        "timings": false,
        "prompt_progress": false,
        "reasoning_control": "",
        "valid_efforts": [],
        "overflow_behavior": "",
        "probed_at": "",
        "findings": []
      }
    }
  ],
  "run": { "max_turns": 40, "cycle_window": 8, "max_consecutive_tool_errors": 3, "max_concurrent": 2, "queue_depth": 0 },
  "approval": { "mode": "boundary-only" },
  "context": { "soft_pct": 0.75, "summary_pct": 0.85, "accounting": "auto" },
  "memory": { "enabled": true, "dir": "memory", "max_tokens": 1500 },
  "tools": {
    "read_file": { "default_limit": 200, "max_limit": 400, "max_line_chars": 500 },
    "list_dir": { "max_entries": 300, "ignore": [".git", "node_modules", "__pycache__", "vendor", "bin", "obj", "dist", ".venv"] },
    "grep": { "max_matches": 50, "max_line_chars": 200 },
    "fetch": {
      "timeout_s": 20,
      "max_bytes": 2097152,
      "max_redirects": 5,
      "default_limit": 200,
      "max_limit": 400,
      "max_line_chars": 500,
      "allow_domains": [],
      "allow_internal_hosts": []
    }
  },
  "shell": {
    "command": ["powershell", "-NoProfile", "-NonInteractive", "-Command"],
    "timeout_s": 60,
    "max_timeout_s": 600,
    "max_output_lines_head": 60,
    "max_output_lines_tail": 40,
    "file_routing_guard": true,
    "operator_context": false,
    "operator_context_timeout_minutes": 60,
    "service_account": { "enabled": false, "account": "agentb-svc", "domain": "." },
    "deny": ["rm -rf /", "format ", "diskpart", "shutdown", "Remove-Item -Recurse -Force C:\\"]
  }
}
